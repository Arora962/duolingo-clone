# Backend configuration. Copy to `.env` and adjust. Every value is optional;
# the defaults shown here work for local development.
#
# The app reads real environment variables and does not load this file itself.
# Load it with:   set -a; . ./.env; set +a
# or run uvicorn: uvicorn app.main:app --reload --env-file .env

# SQLAlchemy database URL. Default: sqlite:///<backend>/duolingo.db
# DATABASE_URL=sqlite:///duolingo.db

# Seed the database on startup (true/false). The seed is idempotent.
AUTO_SEED=false

# Register the simulated-clock routes under /api/dev (set false in production).
ENABLE_DEV_ENDPOINTS=true

# Comma-separated browser origins allowed to call the API.
# In production set this to your deployed frontend URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
